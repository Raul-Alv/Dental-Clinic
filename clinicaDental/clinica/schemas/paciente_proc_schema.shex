PREFIX fhir: <http://hl7.org/fhir/>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX fhir:  <http://hl7.org/fhir/>
# Punto de entrada
start = @<PatientShape>

<PatientShape> {
  rdf:type             		   [ fhir:Patient ] ;
  fhir:Patient.active          xsd:boolean ;                      # true/false
  fhir:Patient.name            @<HumanNameShape>+ ;               # al menos uno
  fhir:Patient.gender          [ "male" "female" "other" "unknown" ] ;
  fhir:Patient.birthDate       xsd:date ;
  fhir:Patient.maritalStatus   [ "S" "C" "D" "unmarried" ]? ;     # acepta "unmarried"
  fhir:Patient.telecom         @<TelecomShape>* ;                 # cero o más
  fhir:Patient.address         @<AddressShape>* ;                 # cero o más
}

<TelecomShape> {
  fhir:ContactPoint @<ContactPointShape> ;
}

<HumanNameShape> {
  fhir:HumanName.family  xsd:string ;
  fhir:HumanName.given   xsd:string+
}

<ContactPointShape> {
  fhir:system [ "phone" "email" "url" "fax" "pager" "other" ] ;
  fhir:value  xsd:string
}

<AddressShape> {
  fhir:Address.line       xsd:string+ ;
  fhir:Address.city       xsd:string ;
  fhir:Address.state      xsd:string ;
  fhir:Address.postalCode xsd:string ;
  fhir:Address.country    xsd:string
}

# Forma que valida Procedimientos
<ProcedureShape> {
  a                       [ fhir:Procedure ] ;
  fhir:Procedure.code               @<CodeableConceptShape> ;
  fhir:Procedure.performedDateTime  xsd:date ;
  fhir:Procedure.performer          @<PerformerShape> ;
  fhir:Procedure.status             xsd:string ;
  fhir:Procedure.subject            @<ReferenceWrapperShape> ;
}

<CodeableConceptShape> {
  fhir:CodeableConcept.coding             @<CodingShape>+ ;
  fhir:CodeableConcept.text               xsd:string ;
}

<CodingShape> {
  fhir:Coding.code               xsd:string ;
  fhir:Coding.system             xsd:anyURI ;
}

<PerformerShape> {
  fhir:Procedure.performer.actor              @<ReferenceWrapperShape> ;
}

<ReferenceWrapperShape> {
  fhir:Reference.reference            @<ReferenceShape>                                    ;
}

<ReferenceShape> {
  fhir:value              xsd:string ;
}